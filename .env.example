# ─────────────────────────────────────────────────────────────────────────────
# NEXUS — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Canonical public URL (used by next/og, metadata.metadataBase, sitemaps, etc.)
NEXT_PUBLIC_BASE_URL=https://engardeeskrim.com
NEXT_PUBLIC_SITE_URL=https://engardeeskrim.com

# ── Spline ────────────────────────────────────────────────────────────────────
# Scene URL exported from app.spline.design  →  Share  →  Copy viewer link
NEXT_PUBLIC_SPLINE_SCENE_URL=https://prod.spline.design/YOUR_SCENE_ID/scene.splinecode

# If you use more than one scene, add them here:
# NEXT_PUBLIC_SPLINE_HERO_URL=https://prod.spline.design/HERO_ID/scene.splinecode
# NEXT_PUBLIC_SPLINE_ABOUT_URL=https://prod.spline.design/ABOUT_ID/scene.splinecode

# ── Analytics ─────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID  (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Analytics — no key needed, enable in Vercel dashboard.
# Plausible self-hosted alternative:
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=nexus.design
# NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io

# ── Contact / Forms ───────────────────────────────────────────────────────────
# Resend API key  (https://resend.com) — server-side only, NOT prefixed with NEXT_PUBLIC_
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL_FROM=hello@nexus.design
CONTACT_EMAIL_TO=team@nexus.design

# ── GSAP ─────────────────────────────────────────────────────────────────────
# Only required if you use GSAP Club (GreenSock) plugins (SplitText, MorphSVG…)
# Leave empty when using the free tier / @gsap/react from npm.
# GSAP_AUTH_TOKEN=

# ── Three.js / Draco / Basis decoders ────────────────────────────────────────
# Path to Draco WASM decoder files (relative to /public).
# Defaults work out-of-the-box when you copy the decoder files to /public/draco/.
NEXT_PUBLIC_DRACO_DECODER_PATH=/draco/
NEXT_PUBLIC_BASIS_TRANSCODER_PATH=/basis/

# ── Feature flags ─────────────────────────────────────────────────────────────
# Show R3FScene (WebGL canvas).  Set "false" to fall back to a static image
# on low-end devices in production.
NEXT_PUBLIC_ENABLE_3D=true

# Show Spline iframe embed.  Set "false" to render a poster image instead.
NEXT_PUBLIC_ENABLE_SPLINE=true

# ── Vercel / Deployment ───────────────────────────────────────────────────────
# Set automatically by Vercel — do not set manually.
# VERCEL_ENV=production | preview | development
# NEXT_PUBLIC_VERCEL_URL=your-deployment.vercel.app
